{
  "name": "com.gitdeck.plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stream Deck plugin for GitDeck: repo status, fetch, and quick commit from a key.",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.gitdeck.plugin\""
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0",
    "vscode-jsonrpc": "^9.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.14.0",
    "rollup": "^4.24.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0"
  }
}
