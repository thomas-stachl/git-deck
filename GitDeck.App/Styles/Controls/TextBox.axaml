<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource GitdeckInputBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource GitdeckForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GitdeckInputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="CaretBrush" Value="{DynamicResource GitdeckForegroundBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource GitdeckInputPlaceholderBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource GitdeckFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource GitdeckFontSizeNormal}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource GitdeckListSelectedBackgroundBrush}" />
  </Style>

  <!-- FluentTheme's own TextBox theme sets Background per pointerover/focus state via its own
       resources; re-assert ours here so the input surface stays constant across states, matching
       VS Code (only the border changes color on focus, the fill never does). -->
  <Style Selector="TextBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource GitdeckInputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GitdeckInputBorderBrush}" />
  </Style>

  <Style Selector="TextBox:focus, TextBox:focus-within">
    <Setter Property="Background" Value="{DynamicResource GitdeckInputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GitdeckFocusBorderBrush}" />
  </Style>

  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

</Styles>
