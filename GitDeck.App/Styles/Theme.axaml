<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- VS Code-inspired theme: Colors.axaml / Typography.axaml hold the palette and type
       scale as theme-variant-aware resources; each Controls/*.axaml file styles one
       control type off of those shared resources. -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GitDeck.App/Styles/Colors.axaml" />
        <ResourceInclude Source="avares://GitDeck.App/Styles/Typography.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <StyleInclude Source="avares://GitDeck.App/Styles/Controls/Window.axaml" />
  <StyleInclude Source="avares://GitDeck.App/Styles/Controls/TextBlock.axaml" />
  <StyleInclude Source="avares://GitDeck.App/Styles/Controls/Button.axaml" />
  <StyleInclude Source="avares://GitDeck.App/Styles/Controls/TextBox.axaml" />
  <StyleInclude Source="avares://GitDeck.App/Styles/Controls/ListBox.axaml" />

</Styles>
