<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="GitdeckFontFamily">Segoe UI,Inter,sans-serif</FontFamily>

  <x:Double x:Key="GitdeckFontSizeSmall">12</x:Double>
  <x:Double x:Key="GitdeckFontSizeNormal">13</x:Double>
  <x:Double x:Key="GitdeckFontSizeLarge">15</x:Double>

</ResourceDictionary>
