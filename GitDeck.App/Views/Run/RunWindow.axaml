<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitDeck.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="76"
        x:Class="GitDeck.App.Views.Run.RunWindow"
        x:DataType="vm:RunViewModel"
        Width="640"
        SizeToContent="Height"
        CanResize="False"
        ShowActivated="True"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="Transparent">

    <Border Background="{DynamicResource GitdeckOverlayBackgroundBrush}"
            CornerRadius="10"
            BorderBrush="{DynamicResource GitdeckBorderBrush}"
            BorderThickness="1"
            BoxShadow="0 8 32 0 #66000000">
        <StackPanel>
            <TextBox Name="SearchBox"
                     Text="{Binding SearchText}"
                     PlaceholderText="Search..."
                     BorderThickness="0"
                     Background="Transparent"
                     FontSize="24"
                     Padding="18,16"
                     CaretBrush="{DynamicResource GitdeckForegroundBrush}"
                     Foreground="{DynamicResource GitdeckForegroundBrush}" />

            <Border Height="1"
                    Margin="12,0"
                    Background="{DynamicResource GitdeckBorderBrush}"
                    IsVisible="{Binding HasResults}" />

            <ListBox ItemsSource="{Binding Results}"
                     SelectedIndex="{Binding SelectedIndex}"
                     IsVisible="{Binding HasResults}"
                     Focusable="False"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="8,6">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RunResult">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Icon}"
                                       FontSize="22"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource GitdeckForegroundBrush}"
                                           FontSize="15" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Foreground="{DynamicResource GitdeckMutedForegroundBrush}"
                                           FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>

</Window>
