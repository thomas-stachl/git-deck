<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitDeck.App.ViewModels"
        xmlns:run="using:GitDeck.App.Views.Run"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="76"
        x:Class="GitDeck.App.Views.Run.RunWindow"
        x:DataType="vm:RunViewModel"
        Width="640"
        SizeToContent="Height"
        CanResize="False"
        ShowActivated="True"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="Transparent">

    <Border Background="{StaticResource PaletteSurfaceBrush}"
            CornerRadius="10"
            BorderBrush="{StaticResource PaletteOutlineBrush}"
            BorderThickness="1"
            BoxShadow="0 8 32 0 #66000000">
        <StackPanel>
            <!-- Both palettes stay instantiated and are switched by IsActive, so toggling modes by
                 hotkey never rebuilds a visual tree.

                 Their DataContext is assigned in the constructor rather than bound here: a bound
                 DataContext only replaces the inherited one after the control has attached, and in
                 that window every binding inside the control evaluates against this window's view
                 model and fails to cast. -->
            <run:BranchPaletteView x:Name="BranchView"
                                   x:DataType="vm:BranchPaletteViewModel"
                                   IsVisible="{Binding IsActive}" />

            <run:CommitPaletteView x:Name="CommitView"
                                   x:DataType="vm:CommitPaletteViewModel"
                                   IsVisible="{Binding IsActive}" />

            <!-- Repository context, so it is clear which repository a switch would affect.
                 Always shown: with no repository configured, this is where the user is told so and
                 how to fix it. -->
            <Border BorderBrush="{StaticResource PaletteDividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,6,10,6">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding RepositoryPathDisplay}"
                               Foreground="{StaticResource PaletteFooterBrush}"
                               FontSize="{StaticResource PaletteCaptionFontSize}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="🌿"
                               IsVisible="{Binding HasHead}"
                               FontSize="{StaticResource PaletteSmallCaptionFontSize}"
                               Margin="16,0,6,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding HeadDisplay}"
                               Foreground="{StaticResource PaletteFooterValueBrush}"
                               FontSize="{StaticResource PaletteCaptionFontSize}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding UpstreamDisplay}"
                               IsVisible="{Binding HasUpstreamDisplay}"
                               Foreground="{StaticResource PaletteFooterBrush}"
                               FontSize="{StaticResource PaletteCaptionFontSize}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding ChangesDisplay}"
                               Foreground="{StaticResource PaletteFooterBrush}"
                               FontSize="{StaticResource PaletteCaptionFontSize}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="5"
                            Classes="footer"
                            Content="⚙"
                            Click="OnSettingsClick"
                            ToolTip.Tip="Open GitDeck settings"
                            Foreground="{StaticResource PaletteSecondaryBrush}"
                            FontSize="{StaticResource PaletteBodyFontSize}"
                            Padding="7,1"
                            Margin="10,0,0,0"
                            Cursor="Hand"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>

</Window>
