<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitDeck.App.ViewModels"
             x:DataType="vm:SettingsViewModel"
             x:Class="GitDeck.App.Views.Settings.SettingsView">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:SettingsViewModel />
    </Design.DataContext>
    <StackPanel Spacing="8" Margin="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Switch Branches" Command="{Binding OpenBranchPaletteCommand}" />
            <Button Content="Commit Changes" Command="{Binding OpenCommitPaletteCommand}" />
        </StackPanel>

        <TextBlock Text="Repository Path" FontWeight="Bold" Margin="0,16,0,0" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                    Command="{Binding BrowseRepositoryPathCommand}" />
            <TextBox Text="{Binding RepositoryPath}" PlaceholderText="No repository selected" />
        </DockPanel>

        <TextBlock Text="Hotkeys" FontWeight="Bold" Margin="0,16,0,0" />
        <StackPanel Spacing="8" DataContext="{Binding BranchHotkey}">
            <TextBlock Text="{Binding Label}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0"
                        Command="{Binding ClearCommand}" />
                <TextBox Text="{Binding Display, Mode=OneWay}"
                         PlaceholderText="Click here and press a combination"
                         IsReadOnly="True"
                         KeyDown="OnHotkeyBoxKeyDown" />
            </DockPanel>
            <TextBlock Text="{Binding Status}" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="8" Margin="0,8,0,0" DataContext="{Binding CommitHotkey}">
            <TextBlock Text="{Binding Label}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0"
                        Command="{Binding ClearCommand}" />
                <TextBox Text="{Binding Display, Mode=OneWay}"
                         PlaceholderText="Click here and press a combination"
                         IsReadOnly="True"
                         KeyDown="OnHotkeyBoxKeyDown" />
            </DockPanel>
            <TextBlock Text="{Binding Status}" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="Branches" FontWeight="Bold" Margin="0,16,0,0" />
        <CheckBox IsChecked="{Binding PublishNewBranchesToRemote}"
                  Content="Publish new branches to the remote" />
        <TextBlock Text="Creating a branch always switches to it, like 'git switch -c'. With this on, it is also pushed to the remote and set as its upstream."
                   Foreground="Gray"
                   TextWrapping="Wrap" />

        <TextBlock Text="Commit Message Generation" FontWeight="Bold" Margin="0,16,0,0" />
        <CheckBox IsChecked="{Binding IsAiEnabled}"
                  Content="Let a model write commit messages (Ctrl+G)" />
        <TextBlock Text="Generating a message sends the diff of the selected files to the provider below. Off by default."
                   Foreground="Gray"
                   TextWrapping="Wrap" />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" IsEnabled="{Binding IsAiEnabled}"
              Margin="0,4,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" VerticalAlignment="Center" Margin="0,0,8,4" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding AiProviders}"
                      SelectedItem="{Binding AiProvider}"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AiModel}" />
        </Grid>

        <StackPanel Spacing="8" IsVisible="{Binding IsBaseUrlRelevant}" IsEnabled="{Binding IsAiEnabled}">
            <TextBox Text="{Binding AiBaseUrl}"
                     PlaceholderText="https://api.openai.com/v1" />
            <TextBlock Text="Include the version path. Works with OpenAI, Azure OpenAI, OpenRouter, Groq, Mistral, and local Ollama or LM Studio (http://localhost:11434/v1)."
                       Foreground="Gray"
                       TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel IsEnabled="{Binding IsAiEnabled}">
            <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0"
                    Command="{Binding ClearAiApiKeyCommand}" />
            <TextBox Text="{Binding AiApiKey}"
                     PlaceholderText="Paste an API key to store it"
                     PasswordChar="•" />
        </DockPanel>
        <TextBlock Text="{Binding AiKeyStatus}"
                   Foreground="Gray"
                   TextWrapping="Wrap" />

        <TextBlock Text="Git Executable" FontWeight="Bold" Margin="0,16,0,0" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                    Command="{Binding BrowseGitExecutablePathCommand}" />
            <TextBox Text="{Binding GitExecutablePath}" PlaceholderText="Uses 'git' on PATH" />
        </DockPanel>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Check" Margin="8,0,0,0"
                    Command="{Binding CheckGitAvailabilityCommand}" />
            <TextBlock Text="{Binding GitStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </StackPanel>
</UserControl>