<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitDeck.App.ViewModels"
             xmlns:controls="using:GitDeck.App.Controls"
             x:DataType="vm:SettingsViewModel"
             x:Class="GitDeck.App.Views.Settings.SettingsView">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:SettingsViewModel />
    </Design.DataContext>
    <StackPanel Spacing="8" Margin="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Switch Branches" Command="{Binding OpenBranchPaletteCommand}" />
            <Button Content="Commit Changes" Command="{Binding OpenCommitPaletteCommand}" />
        </StackPanel>

        <TextBlock Text="Repository Path" FontWeight="Bold" Margin="0,16,0,0" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                    Command="{Binding BrowseRepositoryPathCommand}" />
            <TextBox Text="{Binding RepositoryPath, UpdateSourceTrigger=LostFocus}" PlaceholderText="No repository selected" />
        </DockPanel>

        <TextBlock Text="Hotkeys" FontWeight="Bold" Margin="0,16,0,0" />
        <ItemsControl ItemsSource="{Binding Hotkeys.Editors}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HotkeyEditorViewModel">
                    <StackPanel Spacing="8" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Label}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0"
                                    Command="{Binding ClearCommand}" />
                            <controls:HotkeyBox Gesture="{Binding Hotkey}"
                                                PlaceholderText="Click here and press a combination" />
                        </DockPanel>
                        <TextBlock Text="{Binding Status}" Foreground="Gray" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Branches" FontWeight="Bold" Margin="0,16,0,0" />
        <CheckBox IsChecked="{Binding PublishNewBranchesToRemote}"
                  Content="Publish new branches to the remote" />
        <TextBlock Text="Creating a branch always switches to it, like 'git switch -c'. With this on, it is also pushed to the remote and set as its upstream."
                   Foreground="Gray"
                   TextWrapping="Wrap" />

        <StackPanel Spacing="8" DataContext="{Binding Ai}" x:DataType="vm:AiSettingsViewModel">
            <TextBlock Text="Commit Message Generation" FontWeight="Bold" Margin="0,16,0,0" />
            <CheckBox IsChecked="{Binding IsEnabled}"
                      Content="Let a model write commit messages (Ctrl+G)" />
            <TextBlock Text="Generating a message sends the diff of the selected files to the provider below. Off by default."
                       Foreground="Gray"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" IsEnabled="{Binding IsEnabled}"
                  Margin="0,4,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" VerticalAlignment="Center" Margin="0,0,8,4" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding Provider}"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Model, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="Provider default" />
            </Grid>

            <TextBlock Text="{Binding ProviderNote}"
                       Foreground="Gray"
                       TextWrapping="Wrap" />

            <StackPanel Spacing="8" IsVisible="{Binding IsBaseUrlRelevant}" IsEnabled="{Binding IsEnabled}">
                <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="https://api.openai.com/v1" />
                <TextBlock Text="Include the version path. Works with OpenAI, Azure OpenAI, OpenRouter, Groq, Mistral, and local Ollama or LM Studio."
                           Foreground="Gray"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Claude Code carries its own credentials, so the key row is hidden for it entirely. -->
            <StackPanel Spacing="8" IsVisible="{Binding IsApiKeyRelevant}" IsEnabled="{Binding IsEnabled}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0"
                            Command="{Binding ClearApiKeyCommand}" />
                    <Button DockPanel.Dock="Right" Content="Save" Margin="8,0,0,0"
                            Command="{Binding SaveApiKeyCommand}" />
                    <TextBox Text="{Binding ApiKey}"
                             PlaceholderText="Enter an API key to store it"
                             PasswordChar="•" />
                </DockPanel>
                <TextBlock Text="{Binding KeyStatus}"
                           Foreground="Gray"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Content="Use local Ollama"
                    Command="{Binding UseOllamaPresetCommand}"
                    IsEnabled="{Binding IsEnabled}"
                    HorizontalAlignment="Left" />
        </StackPanel>

        <TextBlock Text="Git Executable" FontWeight="Bold" Margin="0,16,0,0" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                    Command="{Binding BrowseGitExecutablePathCommand}" />
            <TextBox Text="{Binding GitExecutablePath, UpdateSourceTrigger=LostFocus}" PlaceholderText="Uses 'git' on PATH" />
        </DockPanel>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Check" Margin="8,0,0,0"
                    Command="{Binding CheckGitAvailabilityCommand}" />
            <TextBlock Text="{Binding GitStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </StackPanel>
</UserControl>
